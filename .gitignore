# ==========================================
# Video Browsing System - Git Ignore
# ==========================================

# Backend & Maven
backend/target/
backend/*.class
backend/.mvn/timing.properties
*.log

# Frontend & Node
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.vite/

# Uploads & Media (keep directory structure)
backend/uploads/*
!backend/uploads/.gitkeep

# IDE & OS Metadata
.idea/
.run/
.vscode/
*.iml
*.iws
.DS_Store
Thumbs.db
